{
  "expo": {
    "name": "Vora",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.blindbooksapp.ma9yub",
      "infoPlist": {
        "NSCameraUsageDescription": "Scansiona le pagine dei libri",
        "NSPhotoLibraryUsageDescription": "Seleziona le pagine dei libri dalla galleria",
        "NSMicrophoneUsageDescription": "Non usato ma richiesto da alcune librerie"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.blindbooksapp.ma9yub",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vora accede alla galleria per scansionare i libri",
          "cameraPermission": "Vora usa la fotocamera per scansionare le pagine"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
